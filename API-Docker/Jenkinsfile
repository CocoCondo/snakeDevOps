pipeline {
  agent { label 'Principal' }     // nodo built-in de Jenkins (Linux)
  options { timestamps(); ansiColor('xterm') }

  environment {
    K8S_NS       = 'default'              // namespace de destino
    MANIFEST_DIR = 'API-Docker/k8s'       // carpeta con deployment.yaml, service.yaml, configmap.yml
    DEPLOYMENT   = 'notes1'               // nombre de tu Deployment
    CONTAINER    = 'notes-api'            // nombre del contenedor en el Deployment
  }

  stages {
    stage('Check kubectl') {
      steps {
        sh '''
          echo "Workspace: $WORKSPACE"
          test -d "$MANIFEST_DIR" || { echo "No existe $MANIFEST_DIR en $WORKSPACE"; exit 1; }
          kubectl version --client
          kubectl config current-context
          kubectl get nodes -o wide
        '''
      }
    }

    stage('Apply manifests') {
      steps {
        sh '''
          kubectl apply -n "$K8S_NS" -f "$MANIFEST_DIR/"
          kubectl rollout status deploy/"$DEPLOYMENT" -n "$K8S_NS" --timeout=300s
        '''
      }
    }

    stage('Show service') {
      steps {
        sh '''
          kubectl get deploy/"$DEPLOYMENT" -n "$K8S_NS" -o wide
          kubectl get svc "$DEPLOYMENT" -n "$K8S_NS" -o wide
        '''
      }
    }
  }

  post {
    failure {
      // Diagnóstico útil si el rollout falla
      sh '''
        echo "==== Objects ===="
        kubectl get deploy/"$DEPLOYMENT" -n "$K8S_NS" -o wide || true
        kubectl get rs,po -l app="$DEPLOYMENT" -n "$K8S_NS" -o wide || true

        echo "==== Describe Pods ===="
        kubectl describe po -l app="$DEPLOYMENT" -n "$K8S_NS" || true

        echo "==== Events ===="
        kubectl get events -n "$K8S_NS" --sort-by=.metadata.creationTimestamp | tail -n 200 || true

        echo "==== Logs (container) ===="
        kubectl logs deploy/"$DEPLOYMENT" -c "$CONTAINER" -n "$K8S_NS" --tail=200 || true
      '''
    }
  }
}